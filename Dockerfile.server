# 国内云服务器（阿里云/腾讯云轻量）部署用——与 Dockerfile.server 的区别：
# 1. pip 走阿里云镜像源（官方源国内构建卡死，runbook 坑1/坑2）
# 2. 不装 docling（torch 系依赖 2G+，轻量服务器扛不住）：
#    extract.py 兜底链保证 .docx→python-docx、.pdf→pypdf 照常解析，
#    仅扫描版 PDF（无文本层）会提示改传文本
# 3. 非 root 运行（外部审计 P3：最小权限）
# 运行：docker run -p 8080:8080 -e PORT=8080 -e BASIC_AUTH_USERNAME=... -e BASIC_AUTH_PASSWORD=... -e DEEPSEEK_API_KEY=...
FROM python:3.12-slim

RUN useradd --create-home --uid 1000 appuser

WORKDIR /app

# 依赖用 lock 文件（requirements-lock.txt，自线上验证环境冻结）——
# 审计 P3：开放版本范围会导致服务器重建不可复现
COPY requirements.txt requirements-lock.txt ./
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --upgrade pip && \
    pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        -r requirements-lock.txt

COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser config ./config

USER appuser

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
