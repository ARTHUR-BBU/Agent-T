# 国内云服务器（阿里云/腾讯云轻量）部署用——与 Dockerfile.server 的区别：
# 1. pip 走阿里云镜像源（官方源国内构建卡死，runbook 坑1/坑2）
# 2. 不装 docling（torch 系依赖 2G+，轻量服务器扛不住）：
#    extract.py 兜底链保证 .docx→python-docx、.pdf→pypdf 照常解析，
#    仅扫描版 PDF（无文本层）会提示改传文本
# 运行：docker run -p 8080:8080 -e PORT=8080 -e BASIC_AUTH_USERNAME=... -e BASIC_AUTH_PASSWORD=... -e ZHIPU_API_KEY=...
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --upgrade pip && \
    pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
        -r requirements.txt pypdf==6.17.0

COPY app ./app
COPY config ./config

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
