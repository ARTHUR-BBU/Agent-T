# —— 追问（智能解释）——
# 没有 Key 也能跑清单审查；追问页会显示「追问暂未开通」
# 注意：本文件只是模板，真 Key 填在 .env（git 已忽略），启动时必须带 --env-file .env

# DeepSeek（OpenAI 兼容，优先级最高——GLM Coding Plan 限定指定工具使用，
# web 服务调用不享套餐额度会被降权；标准计费无此问题）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_BASE=https://api.deepseek.com

ZHIPU_API_KEY=
# GLM_API_KEY=          # 与 ZHIPU_API_KEY 二选一即可
GLM_MODEL=glm-5.2

# Coding 套餐 Key 用下面这个；标准开放平台 API Key 改成：
# https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# —— 补盲（盲点候选，M2.5）——
# 默认开启。规则未标「需关注」时，有 Key 可提出「候选需关注」（须有原文引用；不覆盖规则标签）
# 设为 false / 0 / no 则与纯规则路径完全一致，界面不出现「补盲」字样
BLIND_SPOT_ENABLED=true

# —— 可选回退（一般不用）——
# XAI_API_KEY=
# GROK_API_KEY=
# GROK_MODEL=grok-2-latest

# —— 公网部署访问控制（公开 URL 必配）——
# 两项同时非空才启用整站 Basic Auth（/health 除外）；本地留空即关闭
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# —— 存储与超时（2026-09-07 审计整改）——
# 审查记录 SQLite 库路径（默认系统临时目录）；记录保留时长（小时，0=永久）
# STORE_DB_PATH=
# STORE_TTL_HOURS=24
# 单次大模型调用超时秒数
# LLM_TIMEOUT_SECONDS=180
# LLM 预审（上传时合同分类）：默认开启；设 false 关闭则行为退回纯规则
# PRECHECK_ENABLED=true
# 预审独立超时秒数（分类调用比评分快，短超时防上传被拖死）
# PRECHECK_TIMEOUT_SECONDS=30

# —— 限频与预算（阶段 0.5）——
# 每 IP 每分钟上传/追问请求数上限；0=关闭；超限 429「过于频繁」+ Retry-After。
# 单进程假设：多 worker 部署时限额按 worker 数放大
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_ASK_PER_MINUTE=20
# 单次审查（预审+评分/补盲）LLM 调用总量上限；0=不限；超限走软降级
# （评分卡 unavailable(budget_exceeded)、预审 skip），规则引擎照常。
# 阶段 1.2 分段阅读后最坏 8 次（预审 2 + 分段 map 4 + 汇总 2）
# LLM_BUDGET_PER_REVIEW=12
# 长合同分段阅读的阅读块数上限（阶段 1.2；默认 4，每块 ≤6000 字）
# LLM_REVIEW_MAX_SEGMENTS=4

# —— 模型分级（阶段 0.5）——
# flash=分诊/定位（预审），重模型=研判（评分/补盲/追问）。
# 未设或空白则回落原模型变量——默认配置零行为变化
# DEEPSEEK_MODEL_PRECHECK=
# DEEPSEEK_MODEL_REVIEW=
# GLM_MODEL_PRECHECK=
# GLM_MODEL_REVIEW=
# GROK_MODEL_PRECHECK=
# GROK_MODEL_REVIEW=
# xAI 调用超时秒数（原写死 60s 提为可配，默认不变）
# XAI_TIMEOUT_SECONDS=60
