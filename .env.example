# —— 追问（智能解释）——
# 没有 Key 也能跑清单审查；追问页会显示「追问暂未开通」
# 注意：本文件只是模板，真 Key 填在 .env（git 已忽略），启动时必须带 --env-file .env
ZHIPU_API_KEY=
# GLM_API_KEY=          # 与 ZHIPU_API_KEY 二选一即可
GLM_MODEL=glm-5.2

# Coding 套餐 Key 用下面这个；标准开放平台 API Key 改成：
# https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# —— 补盲（盲点候选，M2.5）——
# 默认开启。规则未标「需关注」时，有 Key 可提出「候选需关注」（须有原文引用；不覆盖规则标签）
# 设为 false / 0 / no 则与纯规则路径完全一致，界面不出现「补盲」字样
BLIND_SPOT_ENABLED=true

# —— 可选回退（一般不用）——
# XAI_API_KEY=
# GROK_API_KEY=
# GROK_MODEL=grok-2-latest

# —— 公网部署访问控制（HF Spaces 等公开 URL 必配）——
# 两项同时非空才启用整站 Basic Auth（/health 除外）；本地留空即关闭
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=
